{
  "name": "rhea-monorepo",
  "private": true,
  "version": "1.0.1",
  "description": "Rhea.js monorepo. Made by Shams Ali Shaikh.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build -w @rheajs/core -w @rheajs/auth -w @rheajs/cli -w create-rhea",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/auth --noEmit && tsc -p packages/cli --noEmit && tsc -p apps/website --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:security": "vitest run -c vitest.security.config.ts",
    "audit:all": "node scripts/audit-all.mjs",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run build && npm run lint && npm run typecheck && npm test",
    "build:website": "npm run build -w @rheajs/website",
    "release:check": "node scripts/check-release.mjs",
    "set-repo": "node scripts/set-repo.mjs",
    "bench": "node scripts/bench.mjs",
    "soak": "node scripts/soak.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "~5.0.5",
    "autocannon": "^8.0.0",
    "eslint": "^10.13.0",
    "ioredis": "^5.11.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "~5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
